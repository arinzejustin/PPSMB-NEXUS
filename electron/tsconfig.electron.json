{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext"
        ],
        "strict": true,
        "rootDir": ".",
        "outDir": "../dist-electron",
        "moduleResolution": "Bundler",
        "baseUrl": "..",
        "paths": {
            "@/*": [
                "./*"
            ]
        },
        "types": [
            "node",
            "electron"
        ],
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "**/*.ts",
        "**/*.cts"
    ]
}