{
  "name": "ppsmb-enugu-nexus",
  "productName": "PPSMB Enugu Nexus",
  "type": "module",
  "private": true,
  "version": "0.11.9",
  "description": "Information Processing System Management & Communication System",
  "author": "Axiolot Hub <support@axiolot.com.ng>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:nuxt": "nuxt dev",
    "build:nuxt": "nuxt build --node-env production",
    "generate:nuxt": "nuxt generate",
    "postinstall:nuxt": "nuxt prepare",
    "dev:go": "cd go && air",
    "go:tidy": "cd go && go mod tidy",
    "build:go": "cd go && go build -o tmp/build_server.exe",
    "build:electron": "tsc -p electron/tsconfig.electron.json",
    "watch:electron": "tsc -p electron/tsconfig.electron.json --watch",
    "postinstall:electron": "npx electron-rebuild install-app-deps",
    "dev:electron": "wait-on http://localhost:3000 && nodemon",
    "app:dev": "concurrently -n \"NUXT,TSC,ELECTRON,GO\" -c \"green,blue,yellow,red\" \"npm run dev:nuxt\" \"npm run watch:electron\" \"npm run dev:electron\" \"npm run dev:go\"",
    "app:build": "npm run build:nuxt && npm run build:electron && electron-builder && npm run build:go",
    "postinstall": "concurrently -n \"NUXT,ELECTRON\" -c \"green,blue\" \"npm run postinstall:nuxt\" \"npm run postinstall:electron\""
  },
  "dependencies": {
    "@node-rs/bcrypt": "^1.10.7",
    "@seald-io/nedb": "^4.1.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@tiptap/vue-3": "^3.18.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^0.562.0",
    "nuxt": "^4.2.2",
    "reka-ui": "^2.7.0",
    "shadcn-nuxt": "^2.4.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "vue": "^3.5.26",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^7.0.0-beta.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "ng.com.axiolot.nexus.ppsmb-enugu",
    "productName": "PPSMB Enugu Nexus",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      ".output/public/**/*",
      ".output/server/**/*",
      "public/**/*"
    ],
    "asarUnpack": [
      ".output/server/**",
      ".output/public/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.axiolot.com.ng/ppsmb-enugu/updates",
        "channel": "latest"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico",
      "extraFiles": [
        {
          "from": "build/visualElementsManifest.xml",
          "to": "ppsmb-enugu-nexus.VisualElementsManifest.xml"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "deleteAppDataOnUninstall": true,
      "perMachine": true,
      "unicode": true,
      "menuCategory": "PPSMB"
    }
  }
}