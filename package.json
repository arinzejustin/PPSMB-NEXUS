{
  "name": "ppsmb-file-manager",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:nuxt": "nuxt dev",
    "build:nuxt": "nuxt build",
    "generate:nuxt": "nuxt generate",
    "postinstall:nuxt": "nuxt prepare",
    "build:electron": "tsc -p electron/tsconfig.electron.json",
    "watch:electron": "tsc -p electron/tsconfig.electron.json --watch",
    "postinstall:electron": "electron-rebuild",
    "dev:electron": "wait-on http://localhost:3000 && nodemon",
    "app:dev": "concurrently -n \"NUXT,TSC,ELECTRON\" -c \"green,blue,yellow\" \"npm run dev:nuxt\" \"npm run watch:electron\" \"npm run dev:electron\"",
    "app:build": "npm run build:nuxt && npm run build:electron && electron-builder",
    "app:postinstall": "concurrently \"npm run postinstall:nuxt\" \"npm run postinstall:electron\""
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "lucide-vue-next": "^0.562.0",
    "nuxt": "^4.2.2",
    "reka-ui": "^2.7.0",
    "shadcn-nuxt": "^2.4.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^7.0.0-beta.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
